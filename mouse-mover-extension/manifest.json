{
  "manifest_version": 3,
  "name": "Mouse Mover",
  "version": "1.1.0",
  "description": "Mueve un cursor de un lado a otro automáticamente dentro de las páginas y genera eventos de movimiento del mouse.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mouse Mover"
  },
  "commands": {
    "toggle-mover": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Iniciar / detener el movimiento"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
